{
  "name": "react-native-curved-tabbar",
  "version": "0.1.0",
  "description": "Curved bottom tab bar for React Navigation with a notched floating center button, ambient glow and sparkles. One line to use, fully customizable when you need it.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/layout.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "react-navigation",
    "bottom-tabs",
    "tab-bar",
    "tabbar",
    "curved-tabbar",
    "notch",
    "fab",
    "svg",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atta-hamamah/react-native-curved-tabbar.git"
  },
  "homepage": "https://github.com/atta-hamamah/react-native-curved-tabbar#readme",
  "bugs": {
    "url": "https://github.com/atta-hamamah/react-native-curved-tabbar/issues"
  },
  "author": "atta-hamamah (https://github.com/atta-hamamah)",
  "license": "MIT",
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=6.0.0",
    "@react-navigation/native": ">=6.0.0",
    "react": ">=17.0.0",
    "react-native": ">=0.71.0",
    "react-native-svg": ">=12.0.0"
  },
  "devDependencies": {
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@types/react": "~19.2.0",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "^15.15.5",
    "typescript": "^5.0.0"
  }
}
