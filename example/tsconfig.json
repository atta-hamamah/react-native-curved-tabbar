{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Type-check against the library source, with its peer dependencies taken from this
    // app (same idea as metro.config.js), so there is only one copy of each type.
    "paths": {
      "react-native-curved-tabbar": ["../src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "react-native-svg": ["./node_modules/react-native-svg"],
      "@react-navigation/*": ["./node_modules/@react-navigation/*"]
    }
  }
}
